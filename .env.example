# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/enrichment_saas

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS Queues
ENR_HTTP_QUEUE=
ENR_BROWSER_QUEUE=
ENR_WEBHOOK_QUEUE=
ENR_EXPORT_QUEUE=

# Auth
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Lemon Squeezy (https://app.lemonsqueezy.com)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_STORE_ID=
APP_URL=https://your-app.pages.dev

# Lemon Squeezy Variant IDs (from your product variants)
LS_VARIANT_STARTER=
LS_VARIANT_GROWTH=
LS_VARIANT_PRO=
LS_VARIANT_CREDITS_100=
LS_VARIANT_CREDITS_500=
LS_VARIANT_CREDITS_1000=

# Deepgram Voice Agent (server-only; never expose in VITE_ variables)
DEEPGRAM_API_KEY=
VOICE_AGENT_ENABLED=false
DEEPGRAM_AGENT_LISTEN_MODEL=flux-general-en
DEEPGRAM_AGENT_MODEL=gpt-5.6-luna
DEEPGRAM_AGENT_FALLBACK_MODEL=gpt-5.4-mini
DEEPGRAM_AGENT_VOICE=flux-kit-en

# AI calling safety locks. Keep outbound false for inbound/test agents.
AI_OUTBOUND_ENABLED=false
ENABLE_AI_OUTBOUND_CALLER=false
AI_MAX_ACTIVE_CALLS=1
AI_MAX_CALLS_PER_MINUTE=3
AI_MAX_OUTBOUND_CALLS_PER_DAY=5
AI_MAX_SECONDS_PER_CALL=180
AI_MAX_MINUTES_PER_DAY=10
AI_MAX_COST_USD_PER_DAY=1
AI_ESTIMATED_COST_USD_PER_MINUTE=0.10
DEEPGRAM_BROWSER_PREVIEW_MAX_SECONDS=120
DEEPGRAM_BROWSER_PREVIEW_MAX_ACTIVE_PER_USER=1
